<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="SilliRec"
        android:textColor="@color/primary_green"
        android:fontFamily="@font/jetbrains_mono_bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textColor="@color/primary_green"
        android:fontFamily="@font/jetbrains_mono_bold"
        android:textSize="14sp"
        android:layout_marginEnd="12dp" />

    <ImageButton
        android:id="@+id/widget_toggle_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/idle_green"
        android:scaleType="centerInside"
        android:contentDescription="Toggle recording" />

</LinearLayout>
